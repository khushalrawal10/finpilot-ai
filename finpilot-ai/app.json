{
  "expo": {
    "name": "FinPilot AI",
    "slug": "finpilot-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/finpilot_app_icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/finpilot_splash_screen.png",
      "resizeMode": "contain",
      "backgroundColor": "#061D42"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.finpilot.ai",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/finpilot_app_icon.png",
        "backgroundColor": "#061D42"
      },
      "package": "com.finpilot.ai",
      "versionCode": 1,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "YOUR_EAS_PROJECT_ID"
      }
    }
  }
}
